# Copy to backend/.env for local development (never commit the real .env).
# Every value can also be supplied as a real environment variable (Railway, CI, shell).

# --- Profile: dev (default, seeds demo data) | prod (requires JWT_SECRET + Cloudinary)
SPRING_PROFILES_ACTIVE=dev

# --- Database (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/community_cleanup?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# --- JWT (at least 32 characters; generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Token lifetime in milliseconds (24h)
JWT_EXPIRATION=86400000

# --- Cloudinary (optional in dev: uploads fall back to backend/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=community-cleanup

# --- SMTP (optional in dev: emails are logged instead of sent)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@communitycleanup.local

# --- URLs
# Frontend origin: used for CORS and links inside emails
FRONTEND_URL=http://localhost:4200
# Comma-separated list if you need several origins (defaults to FRONTEND_URL)
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Public URL of this API (used for locally stored upload URLs)
APP_BASE_URL=http://localhost:8080

# --- Seeded administrator (created on first start if no admin exists)
ADMIN_EMAIL=admin@communitycleanup.local
ADMIN_PASSWORD=Admin@123
# Create demo users/reports/events on an empty database
SEED_DEMO_DATA=true
