# Copy to frontend/.env for local development. Read by scripts/generate-config.mjs, which writes
# public/app-config.json before `npm start` / `npm run build`. On Vercel/Netlify set these as
# environment variables instead.

# Base URL of the Spring Boot API (including /api)
API_BASE_URL=http://localhost:8080/api

# Google Maps JavaScript API key (browser key, restricted by HTTP referrer). Leave empty to use
# manual latitude/longitude entry.
GOOGLE_MAPS_API_KEY=

# Map ID required for Advanced Markers. DEMO_MAP_ID works for development; create your own
# Map ID in Google Cloud for production.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Initial map centre when no location is selected (defaults to Chennai)
DEFAULT_MAP_LAT=13.0827
DEFAULT_MAP_LNG=80.2707
